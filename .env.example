# Telegram BotFather token for @mcee77bot — never commit the real value
TELEGRAM_BOT_TOKEN=

# Public HTTPS origin that serves the Mini App + API (Telegram requires HTTPS).
# Examples: https://<your-tunnel>.ngrok-free.app  or  https://play.example.com
# Bot opens `${WEBAPP_URL}/rocket-bird/` (trailing slash optional).
WEBAPP_URL=

# Optional: SQLite path (default: ./data/gamebot.sqlite)
DATABASE_PATH=./data/gamebot.sqlite

# Fastify API (+ static Mini App)
API_HOST=0.0.0.0
API_PORT=3000

# Local browser testing without Telegram initData (never enable in production)
ALLOW_DEV_SCORE_SUBMIT=true

# Node environment
NODE_ENV=development
