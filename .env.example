# Telegram BotFather token for @mcee77bot — never commit the real value
TELEGRAM_BOT_TOKEN=

# Public HTTPS origin that serves the Mini Apps + API (Telegram requires HTTPS).
# Examples: https://<your-app>.up.railway.app  or  https://play.example.com
# Primary Mini App shell: `${WEBAPP_URL}/app/`
# Air Hockey canvas: `${WEBAPP_URL}/air-hockey/`
# Presence WS: wss://same-host/ws/presence · Game WS: wss://same-host/ws/air-hockey
# BotFather → Menu Button URL must be `${WEBAPP_URL}/app/`
# On Railway, if unset, RAILWAY_PUBLIC_DOMAIN is used as https://$RAILWAY_PUBLIC_DOMAIN
WEBAPP_URL=

# Optional avatar upload directory (default: <dirname DATABASE_PATH>/avatars)
# AVATAR_DIR=/data/avatars

# Optional: SQLite path (default: ./data/gamebot.sqlite; Docker/Railway: /data/gamebot.sqlite)
DATABASE_PATH=./data/gamebot.sqlite

# Fastify API (+ static Mini Apps + WS). Railway/Render inject PORT — prefer PORT in prod.
API_HOST=0.0.0.0
API_PORT=3000
# PORT=3000

# Bot transport for the API process:
#   webhook       — production default (Telegram POSTs to WEBAPP_URL/telegram/webhook)
#   long_polling  — use separate `npm run start:bot` / `dev:bot`
#   none          — API only (local default when NODE_ENV != production)
BOT_MODE=

# Optional webhook hardening (recommended in production)
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# Local browser testing without Telegram initData (NEVER enable in production)
ALLOW_DEV_SCORE_SUBMIT=true

# Admin stats panel (/admin + /api/v1/admin/stats). Never commit the real value.
# Open https://<host>/admin?key=SECRET — sets a session cookie.
# If unset, admin routes return 404.
ADMIN_SECRET=

# --- Separate Telegram admin bot (recommended) ---
# Create a second bot in BotFather; paste its token here (never commit the real value).
# The API process long-polls this bot when both vars below are set.
# Broadcasts and /start resets are delivered to players via TELEGRAM_BOT_TOKEN (@mcee77bot).
ADMIN_BOT_TOKEN=
# Your numeric Telegram user id(s), comma-separated. Only these may use the admin bot.
# Get id via @userinfobot / @getidsbot — do not put usernames here.
ADMIN_TELEGRAM_IDS=

# Node environment
NODE_ENV=development
